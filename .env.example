# Non-secret compose settings (copy to .env and adjust; compose reads .env from this folder). Every value has a
# default in compose.yaml, so .env is optional. Secrets never go here: they are files under secrets/ (reference
# 15.3), created by scripts/dev-secrets.sh locally and by the deploy job in production (ComposeConfigTest).

# API port, published on 127.0.0.1 only.
VERSO_HTTP_PORT=8080
# Image tag; CI uses the git SHA (reference 18.1). Not scoped to the compose project: a build in another checkout
# re-tags the same name.
VERSO_IMAGE_TAG=local
# Customer install from the signed release image (deploy/compose.release.yaml, ADR-0040): a full digest reference,
# never a tag. Left commented on purpose; export it for the install (scripts/verify-release.sh reads it too).
# VERSO_IMAGE=ghcr.io/<owner>/verso@sha256:<64 hex digest>
# prod = ECS JSON logs; the "local" profile is for an IDE run with deploy/compose.local.yaml.
SPRING_PROFILES_ACTIVE=prod
# Container limits (reference 18.2): application, PostgreSQL.
VERSO_MEM_LIMIT=1536m
VERSO_CPUS=2
POSTGRES_MEM_LIMIT=1g
KEYCLOAK_MEM_LIMIT=1g
# Ollama with the bge-m3 embedding model loaded (ADR-0011).
OLLAMA_MEM_LIMIT=6g
# Local chat model and its pinned layer digest (ADR-0006; docs/versions.md). CI uses a small model.
VERSO_CHAT_MODEL=gemma4:e2b
VERSO_CHAT_MODEL_DIGEST=sha256:6dd7ac24fe13a238898e16e253ebc7a72fa27fb83f2658c2f6c241df3af5937d
OLLAMA_CPUS=2
# Backups (ADR-0009): interval = RPO, retention in days (the newest backup is always kept).
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
# Restore drill only: memory for the throwaway database and the decrypted dump; at least the backup size x 3.
RESTORE_TMPFS_SIZE=1g
# Local IDE run only (deploy/compose.local.yaml): host port of the published PostgreSQL.
VERSO_DB_LOCAL_PORT=5432
# Local IDE run only: host port of the published Ollama (deploy/compose.local.yaml).
VERSO_OLLAMA_LOCAL_PORT=11434
# Cloud mode only (deploy/compose.cloud.yaml, ADR-0013): provider (anthropic | openai), its chat model and, for an
# OpenAI-compatible API, the endpoint. The API key is the file secrets/SECRET_CLOUD_API_KEY, never a variable here.
VERSO_CLOUD_PROVIDER=anthropic
VERSO_CLOUD_CHAT_MODEL=claude-sonnet-5-5
VERSO_OPENAI_BASE_URL=https://api.openai.com/v1
# Conversation history retention in days (ADR-0023; KVKK storage limitation, decided by the data controller).
VERSO_HISTORY_RETENTION_DAYS=90
# Audit log (ADR-0026): days audit rows are kept, then deleted (KVKK storage limitation; the data controller decides,
# 30-3650). Rows hold ids and fixed words only, never questions, answers or file names.
VERSO_AUDIT_RETENTION_DAYS=365
# Admin metrics: show k-anonymous "not found" question texts to verso-admin (ADR-0023); off by default.
VERSO_SHOW_UNANSWERED_QUESTIONS=false
# Admin metrics: show the file names of the most and never cited documents (ADR-0023); off by default.
VERSO_SHOW_DOCUMENT_NAMES=false
# Process role (ADR-0039): true runs the ingestion worker in this process; false is API-only. Keep true.
VERSO_INGESTION_ENABLED=true
# Docling sidecar (ADR-0032): set by deploy/compose.docling.yaml; sidecar limits (defaults 4g, 2 CPUs; measured peak 2.2 GB).
DOCLING_MEM_LIMIT=4g
DOCLING_CPUS=2
VERSO_DOCLING_IMAGE_TAG=local
# Microsoft Entra ID as a second trusted issuer (ADR-0041, docs/entra-kurulumu.md); an empty tenant id keeps it off.
# Directory (tenant) GUID; sign-in host; JWKS mirror (empty: Entra's own, needs a route out); API app id and/or
# api:// URI (comma-separated); the MCP app's id (empty: no Entra token on /mcp).
OIDC_ENTRA_TENANT_ID=
OIDC_ENTRA_AUTHORITY=https://login.microsoftonline.com
OIDC_ENTRA_JWK_SET_URI=
OIDC_ENTRA_AUDIENCES=
OIDC_ENTRA_MCP_AUDIENCES=
# Read-only MCP server at /mcp (ADR-0031); off by default. Also switches the edge's /mcp route (deploy/edge/mcp-*.conf).
VERSO_MCP_ENABLED=false
# Public URL of the MCP endpoint (the edge port on this host).
VERSO_MCP_RESOURCE=http://localhost:8080/mcp
# MCP results name the documents the caller may read; false: a short id instead.
VERSO_MCP_SHOW_DOCUMENT_NAMES=true
# SMB connector (ADR-0038): internal networks a connector may reach (CIDR, private ranges only; empty: none) and the
# subnet of the "smb" network deploy/compose.smb.yaml adds (the host firewall rule names it, README).
VERSO_CONNECTOR_ALLOWED_NETWORKS=
VERSO_SMB_SUBNET=172.31.250.0/24
# Observability (profile "obs", ADR-0014): Grafana's host port on 127.0.0.1.
VERSO_GRAFANA_PORT=3000
# Demo identity provider (ADR-0010): host port on 127.0.0.1; it is also part of the token issuer URL.
VERSO_KEYCLOAK_PORT=8180
