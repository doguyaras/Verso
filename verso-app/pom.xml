<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.verso</groupId>
    <artifactId>verso</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>verso-app</artifactId>
  <description>The single deployable (shape A, ADR-0001): assembles the platform starters and the domain modules.</description>

  <properties>
    <!-- 0 tests = failure (reference Ek B lesson 2). A property, not plugin config, so a filtered run
         (-Dtest=... -am) can pass -DfailIfNoTests=false for upstream modules (reference Ek A skill notes). -->
    <failIfNoTests>true</failIfNoTests>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>platform-core</artifactId>
    </dependency>
    <!-- OAuth2 resource server: every request needs a valid access token (ADR-0005). -->
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>platform-security</artifactId>
    </dependency>
    <!-- Domain modules (ADR-0001). document-core brings the migrations of the "document" schema. -->
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>document-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>qa-core</artifactId>
    </dependency>
    <!-- /actuator/prometheus for the observability stack (ADR-0014; reference 8.7). Version from the Boot BOM. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- EmbeddingModel and the local chat model, served by the local Ollama (ADR-0006, ADR-0011). -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-ollama</artifactId>
    </dependency>
    <!-- Cloud mode (ADR-0006, ADR-0013): one image, the chat provider is chosen by configuration
         (spring.ai.model.chat); in local mode neither client is created. -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-anthropic</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-openai</artifactId>
    </dependency>
    <!-- PostgreSQL 18 + pgvector, Flyway (ADR-0002, ADR-0009). The application connects as svc_document (DML only);
         Flyway connects separately as svc_document_migrate (reference 10.1). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Bean Validation provider: without it @Valid is a silent no-op in production while MockMvc tests (which
         bring Hibernate Validator in test scope) stay green (second-round review). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- @Modulithic marks the module root (VersoApp spells out @SpringBootApplication; ADR-0007). Annotations only. -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Spring Modulith module model for verify() (reference 1.1 shape A, 16); test scope until the first
         application module event needs the runtime. -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Real PostgreSQL in tests (reference 16): the same image and init scripts as compose. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Test identity provider (JWKS + token minting) shared with platform-security's tests. -->
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>document-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>platform-security</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The assembly module of shape A depends on every *-core by design; only the core -> core ban is switched
           off here. Each *-core still runs it, so qa-core -> document-core keeps failing (ADR-0007). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>ban-core-to-core</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
