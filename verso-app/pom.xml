<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.verso</groupId>
    <artifactId>verso</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>verso-app</artifactId>
  <description>The single deployable (shape A, ADR-0001): assembles the platform starters and the domain modules.</description>

  <properties>
    <!-- 0 tests = failure (reference Ek B lesson 2). A property, not plugin config, so a filtered run
         (-Dtest=... -am) can pass -DfailIfNoTests=false for upstream modules (reference Ek A skill notes). -->
    <failIfNoTests>true</failIfNoTests>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>platform-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Bean Validation provider: without it @Valid is a silent no-op in production while MockMvc tests (which
         bring Hibernate Validator in test scope) stay green (second-round review). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- @Modulithic marks the module root (VersoApp spells out @SpringBootApplication; ADR-0007). Annotations only. -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Spring Modulith module model for verify() (reference 1.1 shape A, 16); test scope until the first
         application module event needs the runtime. -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The assembly module of shape A depends on every *-core by design; only the core -> core ban is switched
           off here. Each *-core still runs it, so qa-core -> document-core keeps failing (ADR-0007). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>ban-core-to-core</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
