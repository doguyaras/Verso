<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.verso</groupId>
  <artifactId>verso</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>Verso</name>
  <description>Private document Q&amp;A with source citations. Spring AI + local LLMs.</description>

  <modules>
    <module>platform/platform-core</module>
    <module>platform/platform-observability</module>
    <module>platform/platform-security</module>
    <module>services/document/document-core</module>
    <module>verso-app</module>
  </modules>

  <properties>
    <!-- CI-friendly version (reference 3.2). -->
    <revision>0.1.0-SNAPSHOT</revision>
    <!-- Single Java version for compiler, CI (setup-java) and runtime image (reference 18.3). -->
    <maven.compiler.release>25</maven.compiler.release>
    <!-- Mandatory with a BOM import instead of spring-boot-starter-parent: binding names are read without
         reflection on @PathVariable/@RequestParam (reference 3.2). -->
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <spring-boot.version>4.1.1</spring-boot.version>
    <spring-modulith.version>2.1.1</spring-modulith.version>
    <archunit.version>1.5.1</archunit.version>

    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
    <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
    <flatten-maven-plugin.version>1.8.0</flatten-maven-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.verso</groupId>
        <artifactId>platform-core</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>com.verso</groupId>
        <artifactId>platform-observability</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>com.verso</groupId>
        <artifactId>platform-security</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>com.verso</groupId>
        <artifactId>platform-security</artifactId>
        <version>${revision}</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.verso</groupId>
        <artifactId>document-core</artifactId>
        <version>${revision}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Declared under build/plugins, not only pluginManagement; otherwise it never runs (reference 3.2). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <dependencyConvergence/>
              </rules>
            </configuration>
          </execution>
          <!-- core -> core is forbidden; the pattern would also match platform modules, hence the include (reference
               Ek B lesson 1). A separate execution so that the shape-A assembly module (verso-app), which must depend
               on every *-core, can switch off this one rule and nothing else (architecture review, ADR-0007). -->
          <execution>
            <id>ban-core-to-core</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>com.verso:*-core</exclude>
                  </excludes>
                  <includes>
                    <include>com.verso:platform-*</include>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- ${revision} must be resolved in installed/deployed POMs, otherwise consumers (and "-pl" runs without -am)
           cannot find the parent "com.verso:verso:${revision}" (test review, 2026-10-02). -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten-maven-plugin.version}</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <!-- *IT classes run with surefire as well. "0 tests = failure" is set per module that has tests
             (failIfNoTests), so contract modules without tests do not break the build. -->
        <configuration>
          <includes>
            <include>**/*Test.java</include>
            <include>**/*IT.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
