# Build
target/

# IDE
.idea/
*.iml
.vscode/

# Env and secrets (reference 15.3)
.env
.env.*
!.env.example
secrets/*
!secrets/README.md

# Claude Code review stamp (reference 19.4)
.claude/.last-review-check

# flatten-maven-plugin output
.flattened-pom.xml

# Real deploy env files (host names, ports) never enter git; only the *.example templates do.
deploy/**/*.env*
!deploy/**/*.env.example

# The installation's branding (ADR-0021): branding.json and the logo belong to one client; only the example enters git.
/deploy/branding/*
!/deploy/branding/branding.example.json

# demo.sh writes the question body here while it runs
demo-question.tmp
