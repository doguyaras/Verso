{
  "uid": "verso-overview",
  "title": "Verso — genel bakış",
  "tags": [
    "verso"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API up",
      "datasource": {
        "type": "prometheus",
        "uid": "verso-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "verso-prometheus"
          },
          "expr": "up{job=\"verso\"}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Bekleyen belge",
      "datasource": {
        "type": "prometheus",
        "uid": "verso-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "verso-prometheus"
          },
          "expr": "verso_ingestion_queue{status=\"pending\"}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "En eski bekleyen (sn)",
      "datasource": {
        "type": "prometheus",
        "uid": "verso-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "verso-prometheus"
          },
          "expr": "verso_ingestion_oldest_due_wait_seconds"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Model devresi açık",
      "datasource": {
        "type": "prometheus",
        "uid": "verso-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "verso-prometheus"
          },
          "expr": "max(verso_qa_circuit_open) + max(verso_ingestion_paused)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "İstek hızı (durum sınıfına göre)",
      "datasource": {
        "type": "prometheus",
        "uid": "verso-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "verso-prometheus"
          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"verso\",uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "API p95 süre (uca göre)",
      "datasource": {
        "type": "prometheus",
        "uid": "verso-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "verso-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"verso\",uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Sorular (sonuca göre)",
      "datasource": {
        "type": "prometheus",
        "uid": "verso-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "verso-prometheus"
          },
          "expr": "sum by (outcome) (increase(verso_qa_questions_total[15m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Chat ve retrieval p95",
      "datasource": {
        "type": "prometheus",
        "uid": "verso-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "verso-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(verso_qa_chat_duration_seconds_bucket[15m])))",
          "legendFormat": "chat"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "verso-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(verso_qa_retrieval_duration_seconds_bucket[15m])))",
          "legendFormat": "retrieval"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Belge işleme (sonuca göre)",
      "datasource": {
        "type": "prometheus",
        "uid": "verso-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "verso-prometheus"
          },
          "expr": "sum by (outcome) (increase(verso_ingestion_documents_total[15m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Kuyruk",
      "datasource": {
        "type": "prometheus",
        "uid": "verso-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "verso-prometheus"
          },
          "expr": "verso_ingestion_queue",
          "legendFormat": "{{status}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "verso-prometheus"
          },
          "expr": "verso_ingestion_paused",
          "legendFormat": "worker paused"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "JVM heap ve veritabanı bağlantıları",
      "datasource": {
        "type": "prometheus",
        "uid": "verso-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "verso-prometheus"
          },
          "expr": "sum(jvm_memory_used_bytes{job=\"verso\",area=\"heap\"})",
          "legendFormat": "heap"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "verso-prometheus"
          },
          "expr": "hikaricp_connections_active{job=\"verso\"}",
          "legendFormat": "db active"
        }
      ]
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Uygulama log'u (yalnız id, süre, sonuç)",
      "datasource": {
        "type": "loki",
        "uid": "verso-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "verso-loki"
          },
          "expr": "{service=\"verso-app\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true
      }
    }
  ]
}
