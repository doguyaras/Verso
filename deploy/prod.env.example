# Deploy env template (reference 15.1): values come from CI/deploy secrets storage, never from git.
# Every ${VAR} used in verso-app/src/main/resources/config/verso.yml must be declared here (ConfigDriftTest),
# except SECRET_* values, which arrive through /run/secrets (compose secrets + Spring config tree).
SPRING_PROFILES_ACTIVE=prod
# Database (compose service name inside the compose network; ADR-0009).
DB_HOST=postgres
DB_PORT=5432
DB_NAME=verso
# Identity provider (ADR-0005). OIDC_ISSUER: the exact "iss" of the access tokens (the public URL clients use);
# OIDC_JWK_SET_URI: where the application fetches the signing keys. The application has no route out in local mode
# (ADR-0013): this address must be reachable from the internal network (the bundled Keycloak, or a JWKS mirror next
# to the application); attaching the application to a network with a gateway gives up the local-mode guarantee.
OIDC_ISSUER=https://id.example.com/realms/verso
OIDC_JWK_SET_URI=https://id.example.com/realms/verso/protocol/openid-connect/certs
# true only when the JWKS URL is plain HTTP inside a private network (the bundled compose stack); https otherwise.
OIDC_JWKS_ALLOW_HTTP=false
# Where the access token carries roles and groups (ADR-0019), as dotted claim paths. Keycloak: realm_access.roles and
# groups (a "groups" mapper on the client); client roles, if used, resource_access.<client>.roles. Entra ID:
# OIDC_ROLES_CLAIM=roles (app roles) and OIDC_GROUPS_CLAIM=groups (group object ids). Empty = not read.
# The role values verso-admin / verso-user are what the IdP must issue; a caller without one is a verso-user.
OIDC_ROLES_CLAIM=realm_access.roles
OIDC_CLIENT_ROLES_CLAIM=
OIDC_GROUPS_CLAIM=groups
# Microsoft Entra ID accepted directly, without Keycloak (ADR-0041, docs/entra-kurulumu.md). Empty tenant id = off.
# The directory (tenant) GUID; common/organizations/consumers are refused. Entra-only: leave OIDC_ISSUER and
# OIDC_JWK_SET_URI empty. Roles come from "roles", groups from "groups" (object ids; no groups on overage).
OIDC_ENTRA_TENANT_ID=
# Sign-in host of the cloud (public cloud below; US Government: https://login.microsoftonline.us).
OIDC_ENTRA_AUTHORITY=https://login.microsoftonline.com
# Empty = <authority>/<tenant>/discovery/v2.0/keys. In local mode (no route out, ADR-0013) a JWKS mirror inside the
# internal network.
OIDC_ENTRA_JWK_SET_URI=
# The API app registration's client id and/or Application ID URI (api://...), comma-separated.
OIDC_ENTRA_AUDIENCES=
# The MCP app registration's client id (ADR-0031); never one of OIDC_ENTRA_AUDIENCES. Empty: no Entra token on /mcp.
OIDC_ENTRA_MCP_AUDIENCES=
# Models (ADR-0006, ADR-0011): the local Ollama inside the compose network and the pinned embedding model.
OLLAMA_BASE_URL=http://ollama:11434
# The chat model's own Ollama (ADR-0062): a second container, so a stuck chat generation cannot stop the embeddings.
OLLAMA_CHAT_BASE_URL=http://ollama-chat:11434
OLLAMA_EMBEDDING_MODEL=bge-m3:567m
# Local chat model (ADR-0006: a small multilingual Gemma 4; VERSO_CHAT_MODEL in compose).
OLLAMA_CHAT_MODEL=gemma4:e2b
# AI mode (ADR-0006, ADR-0013): local = no model call leaves the host; cloud = only the chat call goes to the provider.
# The provider must match the mode (ollama, or openai for a model server on the internal network, in local mode;
# anthropic or openai for cloud), or the application does not start. The API key is the secret file
# spring.ai.<provider>.api-key under /run/secrets (deploy/compose.cloud.yaml; deploy/compose.llamacpp.yaml, ADR-0051).
VERSO_AI_MODE=local
VERSO_CHAT_PROVIDER=ollama
# Chat model and endpoint of the OpenAI-compatible client: the cloud provider, or the shared-tier model server
# (http://llama:8080/v1, ADR-0051). Its timeout: 30s for a cloud provider, 90s (ADR-0008 local) for the model server.
CLOUD_CHAT_MODEL=claude-sonnet-5-5
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_TIMEOUT=30s
# Chat calls in flight per application instance (ADR-0008, ADR-0051): 1 for a CPU host and the single-user tier; the
# shared tier sets it to the model server's parallel slots (LLAMA_PARALLEL or OLLAMA_NUM_PARALLEL), never above them.
VERSO_QA_CHAT_CONCURRENCY=1
# Conversation history (ADR-0023): days questions and answers are kept, then deleted (KVKK storage limitation; the
# data controller decides, 1-3650). Usage counts without content outlive it.
VERSO_HISTORY_RETENTION_DAYS=90
# Audit log retention in days (ADR-0026; KVKK storage limitation, decided by the data controller, 30-3650).
VERSO_AUDIT_RETENTION_DAYS=365
# Admin metrics (ADR-0023): true lets verso-admin see the texts of "not found" questions that at least 3 different
# users asked (k-anonymity). Off unless the employees' information notice covers this purpose.
VERSO_SHOW_UNANSWERED_QUESTIONS=false
# Admin metrics (ADR-0023): true shows the file names of the most and never cited documents. Off by default: today a
# document belongs to one account, so a name with its daily citations can tell what one employee looked up.
VERSO_SHOW_DOCUMENT_NAMES=false
# Follow-up questions (ADR-0046): in a conversation, a question like "Peki P2 için?" is rewritten by the chat model
# from the last two turns into a standalone search query (one more call on the chat slot). false: every question is
# searched as asked and the conversation history never reaches a model (in cloud mode: never leaves the installation).
VERSO_QA_FOLLOWUP_ENABLED=true
# Answer groundedness (ADR-0047): after the citations are validated, every cited answer sentence that states a number,
# a number word or a code is compared with its cited passages, in-process (no model, no network). A sentence they do
# not support is listed in "unverified" and the panel marks it "dayanağı doğrulanamadı"; the answer is never changed.
# When no cited sentence is supported the answer is UNCITED. false: no check (before ADR-0047).
VERSO_QA_GROUNDING_ENABLED=true
# Answer relevance and abstention (ADR-0064): after the groundedness check, a model answer that refuses in its own words
# (even with a citation), opens with a refusal and adds only loosely related text, or does not give what the question
# asks for (a person for "kim", a number in the asked unit for "kaç", a place for "nerede") is the fixed "not found"
# answer without citations. In-process and lexical (no model, no network). false: the outcome is as before ADR-0064.
VERSO_QA_RELEVANCE_ENABLED=true
# Answer memory (ADR-0049): a question that matches an expert-verified answer card (made by verso-admin from a sourced
# answer) is answered with the card, marked "uzman onaylı", only when the asker can read every cited document and the
# cited text is unchanged. No model call for such an answer. false: every question goes the normal way.
VERSO_QA_KNOWLEDGE_ENABLED=true
# true: a card is served only after two different admins verified it (HR, finance, safety content).
VERSO_QA_KNOWLEDGE_TWO_PERSON_RULE=false
# Procedures (ADR-0053): true shows an approved procedure (skill) whose example questions match the question above the
# generated answer ("Bu bir prosedür"), only to an asker who can read every source of it. Off by default until the
# customer's set measures the match threshold. Drafting, approval, SKILL.md export and MCP work either way.
VERSO_QA_SKILLS_SERVING_ENABLED=false
# System model (ADR-0054): true adds, for a question that names a known code, abbreviation or system, at most two
# passages that define it to the retrieval candidates (only passages the asker may read). Off until measured on the
# customer's evaluation set. The model itself, the "Sistem haritası" screen, the lookup API and verso_lookup work either way.
VERSO_DOCUMENT_SYSTEM_MODEL_ENRICHMENT_ENABLED=false
# System model (ADR-0054): true lets a verso-admin run the local-model pass that proposes extra relations between
# entities of one document, stored as DRAFT for review and never used automatically. Local AI mode only.
VERSO_QA_SYSTEM_MODEL_SUGGESTIONS_ENABLED=false
# Multi-step reasoning (ADR-0055): true splits a comparison or multi-part question ("fark", "karşılaştır", two systems)
# with one chat call into at most 3 standalone sub-questions, searches each with the asker's access, and answers once
# over the passages grouped per sub-question (one more chat call per such question). A sub-question without passages
# is stated as not found; contradiction notes come only from stored checks. In cloud mode the decomposition goes to
# the cloud provider too (the question and system/code names). Off until measured on eval/multihop-set.json.
VERSO_QA_REASONING_ENABLED=false
# Docling sidecar (ADR-0032): layout- and table-aware PDF parsing with OCR. true only together with the
# deploy/compose.docling.yaml overlay, which runs the sidecar on the internal "parsers" network; false keeps the JDK
# parsers alone. Any sidecar failure falls back to the JDK parser.
VERSO_DOCLING_ENABLED=false
VERSO_DOCLING_URL=http://docling:5001
# Cross-encoder reranker (ADR-0043): true only together with the deploy/compose.reranker.yaml overlay (GPU installs),
# which runs the sidecar on the internal "rerankers" network; false keeps the hybrid order of ADR-0022. Any sidecar
# failure keeps that order.
VERSO_RERANKER_ENABLED=false
VERSO_RERANKER_URL=http://reranker:80
# Read-only MCP server (ADR-0031): approved AI clients search the caller's documents through /mcp. Off by default; a
# new access channel for the employees' documents, so turn it on only after the processing record (docs/uyum) covers
# it and the IdP has the verso-mcp client scope and the approved clients. VERSO_MCP_RESOURCE is the public https URL of
# the endpoint (the token's resource and the RFC 9728 metadata). VERSO_MCP_SHOW_DOCUMENT_NAMES=false sends a short
# document id instead of the document and collection names.
VERSO_MCP_ENABLED=false
VERSO_MCP_RESOURCE=https://verso.example.com/mcp
VERSO_MCP_SHOW_DOCUMENT_NAMES=true
# Process role (ADR-0039): true runs the ingestion worker in this process; false runs it API-only (uploads stay
# queued until a process with true drains them). Keep true while Verso runs as one process.
VERSO_INGESTION_ENABLED=true
# SMB connector (ADR-0038): CIDR blocks of the internal networks a connector may reach, comma-separated, private ranges
# only (10/8, 172.16/12, 192.168/16, fc00::/7); e.g. the file server alone as 10.20.30.40/32. Empty: no connector can
# connect. The network route comes from deploy/compose.smb.yaml and the host firewall (README).
VERSO_CONNECTOR_ALLOWED_NETWORKS=
# Confluence connector (ADR-0044): Data Center is reached through VERSO_CONNECTOR_ALLOWED_NETWORKS. Cloud needs internet
# egress, off by default: true plus the host patterns (e.g. *.atlassian.net). Strict local mode (VERSO_AI_MODE=local)
# refuses to start with it on; Cloud needs cloud mode (the VKED names Atlassian as a data source and transfer, docs/uyum).
# SharePoint Online / OneDrive (ADR-0045) is cloud only: true plus
# graph.microsoft.com,login.microsoftonline.com,<tenant>.sharepoint.com (the VKED names Microsoft as a data source and
# transfer); its app's tenant defaults to OIDC_ENTRA_TENANT_ID above.
VERSO_CONNECTOR_EXTERNAL_EGRESS=false
VERSO_CONNECTOR_EXTERNAL_HOSTS=
