# Deploy env template (reference 15.1): values come from CI/deploy secrets storage, never from git.
# Every ${VAR} used in verso-app/src/main/resources/config/verso.yml must be declared here (ConfigDriftTest),
# except SECRET_* values, which arrive through /run/secrets (compose secrets + Spring config tree).
SPRING_PROFILES_ACTIVE=prod
# Database (compose service name inside the compose network; ADR-0009).
DB_HOST=postgres
DB_PORT=5432
DB_NAME=verso
# Identity provider (ADR-0005). OIDC_ISSUER: the exact "iss" of the access tokens (the public URL clients use);
# OIDC_JWK_SET_URI: where the application fetches the signing keys (may be an internal address).
OIDC_ISSUER=https://id.example.com/realms/verso
OIDC_JWK_SET_URI=http://keycloak:8080/realms/verso/protocol/openid-connect/certs
