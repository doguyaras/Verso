  "defaultDefaultClientScopes": [
    "AuthnContextClassRef",
    "acr",
    "basic",
    "email",
    "profile",
    "role_list",
    "roles",
    "saml_organization",
    "web-origins"
  ],
  "defaultOptionalClientScopes": [
    "address",
    "microprofile-jwt",
    "offline_access",
    "organization",
    "phone"
  ],
  "clients": [
    {
      "clientId": "verso-mcp-inspector",
      "name": "MCP Inspector on this computer (authorization code + PKCE; demo client of ADR-0031)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:6274/oauth/callback",
        "http://localhost:6274/oauth/callback/debug"
      ],
      "webOrigins": [
        "http://localhost:6274"
      ],
      "attributes": {
        "access.token.header.type.rfc9068": "true",
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "false"
      },
      "protocolMappers": [],
      "defaultClientScopes": [
        "basic",
        "verso-mcp"
      ],
      "optionalClientScopes": [],
      "consentRequired": true
    },
    {
      "clientId": "verso-cli",
      "name": "Verso command line (device authorization grant)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
