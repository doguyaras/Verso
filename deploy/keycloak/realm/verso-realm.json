      "name": "verso-mcp",
      "description": "Verso MCP server (ADR-0031): an access token for /mcp only, audience verso-mcp, with the user's groups",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
