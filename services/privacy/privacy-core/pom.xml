<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.verso</groupId>
    <artifactId>verso</artifactId>
    <version>${revision}</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>privacy-core</artifactId>
  <description>KVKK data-subject requests (ADR-0034): find, export and erase what Verso holds about one token subject,
    and redact answers that cited a deleted document. No schema of its own: it coordinates the document, qa and audit
    modules through their apis, each writing in its own schema.</description>

  <properties>
    <!-- 0 tests = failure (reference Ek B lesson 2). -->
    <failIfNoTests>true</failIfNoTests>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>privacy-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>document-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>qa-api</artifactId>
    </dependency>
    <!-- Skill runs hold the caller's form inputs (ADR-0057): counted and erased through WorkSubjects. -->
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>work-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>audit-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>platform-core</artifactId>
    </dependency>
    <!-- @PreAuthorize(VersoRoles.HAS_ADMIN) (ADR-0019). -->
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>platform-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Per-module architecture rules (ADR-0007 #7). -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
