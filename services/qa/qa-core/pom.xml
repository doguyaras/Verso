<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.verso</groupId>
    <artifactId>verso</artifactId>
    <version>${revision}</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>qa-core</artifactId>
  <description>Question answering (ADR-0006, ADR-0008, llm-rules 3): retrieval through document-api, prompt, local or
    cloud chat model, server-side citations; conversation history, feedback and usage metrics (ADR-0023).</description>

  <properties>
    <!-- 0 tests = failure (reference Ek B lesson 2). A property, not plugin config, so a filtered run
         (-Dtest=... -am) can pass -DfailIfNoTests=false for upstream modules (reference Ek A skill notes). -->
    <failIfNoTests>true</failIfNoTests>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>qa-api</artifactId>
    </dependency>
    <!-- DocumentRetrieval: the only way into the document module (ADR-0003). -->
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>document-api</artifactId>
    </dependency>
    <!-- AuditEvent: what the module publishes for the audit log (ADR-0026); the only way into the audit module. -->
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>audit-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>platform-core</artifactId>
    </dependency>
    <!-- TraceIds: a streamed answer's background thread keeps the request's trace id (ADR-0035). -->
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>platform-observability</artifactId>
    </dependency>
    <!-- @CurrentAccount AccountId (ADR-0010). -->
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>platform-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- History, feedback and usage rollups in the module's own schema "qa" (ADR-0023): its own pool (HikariCP),
         JdbcClient and Flyway, connected as svc_qa / svc_qa_migrate; never the application DataSource. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!-- The qa pool's health indicator for the readiness group (ADR-0023). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-health</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-api</artifactId>
    </dependency>
    <!-- InfoContributor: the AI mode on /actuator/info (ADR-0006). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-actuator</artifactId>
    </dependency>
    <!-- @ManagementContextConfiguration: X-Rag-Mode on the management port too (llm-rules 1.3). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-actuator-autoconfigure</artifactId>
    </dependency>
    <!-- InetAddressFilter: Boot-built HTTP clients reach internal addresses only (ADR-0006, ADR-0013). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-http-client</artifactId>
    </dependency>
    <!-- ChatModel only; the provider starter is chosen by the assembly (verso-app), ADR-0006. -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-model</artifactId>
    </dependency>
    <!-- The model gateway (ADR-0056) builds every provider's client itself, natively in Spring AI 2.0: the provider
         modules without their auto-configuration (the assembly keeps choosing the built-in model through its
         starters). Licences: Apache-2.0 (Spring AI, the OpenAI/Anthropic Java SDKs, AWS SDK v2, google-genai);
         recorded in docs/versions.md. Mistral uses the OpenAI client (its API is OpenAI-compatible): no extra module. -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-openai</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-anthropic</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-ollama</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-bedrock-converse</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-google-genai</artifactId>
    </dependency>
    <!-- Metrics for Prometheus (ADR-0014): Micrometer, the registry comes with the assembly (verso-app). -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Per-module architecture rules (ADR-0007 #7). -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
