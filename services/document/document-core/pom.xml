<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.verso</groupId>
    <artifactId>verso</artifactId>
    <version>${revision}</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>document-core</artifactId>
  <description>Document module (ADR-0001, ADR-0011): upload, PDF text extraction, chunking, embeddings and the
    ingestion worker; retrieval follows in phase 5.</description>

  <properties>
    <!-- 0 tests = failure (reference Ek B lesson 2). A property, not plugin config, so a filtered run
         (-Dtest=... -am) can pass -DfailIfNoTests=false for upstream modules (reference Ek A skill notes). -->
    <failIfNoTests>true</failIfNoTests>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>document-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>platform-core</artifactId>
    </dependency>
    <!-- @CurrentAccount AccountId (ADR-0010). -->
    <dependency>
      <groupId>com.verso</groupId>
      <artifactId>platform-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-api</artifactId>
    </dependency>
    <!-- EmbeddingModel only; the Ollama starter is chosen by the assembly (verso-app), ADR-0006. -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-model</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
    </dependency>
    <!-- Metrics for Prometheus (ADR-0014): Micrometer, the registry comes with the assembly (verso-app). -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Per-module architecture rules (ADR-0007 #7). -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- TestPdfs (synthetic PDFs built with PDFBox) for verso-app's integration tests. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
